---
---
<div class="row">
  {% if site.enable_publication_thumbnails %}
    <div class="col col-sm-2 abbr">
      {%- if entry.abbr -%}
        {%- if site.data.venues[entry.abbr] -%}
          {% assign venue_style = null %}
          {% if site.data.venues[entry.abbr].color != blank %}
            {% assign venue_style = site.data.venues[entry.abbr].color | prepend: 'style="background-color:' | append: '"' %}
          {%- endif -%}
          <abbr
            class="badge rounded w-100"
            {% if venue_style %}
              {{ venue_style }}
            {% endif -%}
          >
            {% if site.data.venues[entry.abbr].url %}
              <a href="{{ site.data.venues[entry.abbr].url }}">{{ entry.abbr }}</a>
            {% else %}
              <div>{{- entry.abbr -}}</div>
            {% endif %}
          </abbr>
        {% else %}
          <abbr class="badge rounded w-100">{{ entry.abbr }}</abbr>
        {% endif %}
      {% endif %}
      {% if entry.preview %}
        {% if entry.preview contains '://' %}
          <img class="preview z-depth-1 rounded" src="{{ entry.preview }}">
        {% else %}
          {% assign entry_path = entry.preview | prepend: '/assets/img/publication_preview/' %}
          {%
            include figure.liquid
            loading="eager"
            path=entry_path
            sizes = "200px"
            class="preview z-depth-1 rounded"
            zoomable=true
            avoid_scaling=true
            alt=entry.preview
          %}
        {% endif %}
      {% endif %}
    </div>
  {% endif %}

  <!-- Entry bib key -->
  <div id="{{ entry.key }}" class="{% if site.enable_publication_thumbnails %}col-sm-8{% else %}col-12 publication-entry-body{% endif %}">
    <!-- Title -->
    {% assign paper_title_url = nil %}
    {% if entry.doi %}
      {% assign paper_title_url = entry.doi | prepend: 'https://doi.org/' %}
    {% elsif entry.arxiv %}
      {% assign paper_title_url = entry.arxiv | prepend: 'https://arxiv.org/abs/' %}
    {% endif %}
    <div class="paper-title">
      {% if paper_title_url %}
        <a href="{{ paper_title_url }}" class="paper-title-link" target="_blank" rel="noopener noreferrer">{{ entry.title }}</a>
      {% else %}
        {{ entry.title }}
      {% endif %}
    </div>
    <!-- Coauthors, alphabetized by surname for display. -->
    {% assign sorted_authors = entry.author_array | sort: 'last' %}
    {%- capture coauthor_markup -%}
      {%- for author in sorted_authors -%}
        {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' | strip -%}
        {% if site.scholar.last_name contains author_last_name %}
          {% if site.scholar.first_name contains author.first %}
            {% continue %}
          {% endif %}
        {%- endif -%}
        {%- assign author_name = author.first | append: ' ' | append: author_last_name -%}
        {% assign coauthor_url = null %}
        {%- assign clean_last_name = author_last_name | downcase | remove_accents -%}
        {% if site.data.coauthors[clean_last_name] %}
          {%- for coauthor in site.data.coauthors[clean_last_name] -%}
            {% if coauthor.firstname contains author.first %}
              {%- assign coauthor_url = coauthor.url -%}
              {% break %}
            {%- endif -%}
          {% endfor %}
        {%- endif -%}

        {%- if coauthor_url -%}
          <a href="{{ coauthor_url }}" class="author-link">{{ author_name | escape }}</a>
        {%- else -%}
          {{- author_name | escape -}}
        {%- endif -%}
        |||
      {%- endfor -%}
    {%- endcapture -%}
    {% assign coauthors = coauthor_markup | strip | split: '|||' %}
    {% if coauthors.size > 0 %}
      <div class="author">
        with{{ ' ' }}
        {%- for coauthor in coauthors -%}
          {%- unless forloop.first -%}
            {%- if forloop.last -%}
              {%- if coauthors.size > 2 -%}{{ ', and ' }}{%- else -%}{{ ' and ' }}{%- endif -%}
            {%- else -%}
              {{- ', ' -}}
            {%- endif -%}
          {%- endunless -%}
          {{- coauthor | strip -}}
        {%- endfor -%}
        {% if entry.year %}
          <span class="publication-date">
            ({% if entry.status == 'working' and entry.month %}{{ entry.month | capitalize }}&nbsp;{% endif %}{{ entry.year }})
          </span>
        {% endif %}
      </div>
    {% endif %}

    <!-- Publication status and date -->
    {% unless entry.status == 'working' %}
      <div class="periodical">
        {% if entry.type == 'article' %}<em class="publication-venue">{{ entry.journal }}</em>{% endif %}
        {%- if entry.volume %}<span class="publication-citation-separator">,</span> <span class="publication-volume">{{ entry.volume }}</span>{% endif %}{% if entry.number %}({{ entry.number }}){% endif %}{% if entry.pages %}<span class="publication-citation-separator">,</span> <span class="publication-pages">{{ entry.pages | replace: '--', '–' }}</span>{% endif %}
        {% if entry.location %}{{ entry.location }}{% endif %}
        {% if entry.additional_info %}{{ entry.additional_info | markdownify | remove: '<p>' | remove: '</p>' }}{% endif %}
      </div>
    {% endunless %}
    {% if entry.note %}<div class="periodical">{{ entry.note | strip }}</div>{% endif %}

    <!-- Links/Buttons -->
    <div class="links">
      {% if entry.award %}
        <a class="award btn btn-sm z-depth-0" role="button" style="text-transform: none;">
          {%- if entry.award_name %}{{ entry.award_name }}{% else %}Awarded{% endif -%}
        </a>
      {% endif %}

      {% assign link_items = '' %}

      {% if entry.abstract %}
        {% capture link_item %}<a class="abstract btn btn-academic-blue btn-sm rounded-pill" role="button" style="text-transform: none;" onclick="this.classList.toggle('abs-active')"><i class="fas fa-file-alt mr-1"></i><span class="publication-link-label">abstract</span><i class="fas fa-angle-down ml-1 abstract-icon"></i></a>{% endcapture %}
        {% assign link_items = link_items | append: link_item | append: '|||' %}
      {% endif %}

      {% if entry.doi %}
        {% capture link_item %}<a href="https://doi.org/{{ entry.doi }}" class="btn btn-academic-blue btn-sm rounded-pill" target="_blank" rel="noopener noreferrer" role="button" style="text-transform: none;"><i class="ai ai-doi mr-1"></i><span class="publication-link-label">doi</span></a>{% endcapture %}
        {% assign link_items = link_items | append: link_item | append: '|||' %}
      {% endif %}

      {% if entry.arxiv %}
        {% capture link_item %}<a href="http://arxiv.org/abs/{{ entry.arxiv }}" class="btn btn-academic-blue btn-sm rounded-pill" target="_blank" rel="noopener noreferrer" role="button" style="text-transform: none;"><i class="ai ai-arxiv mr-1"></i><span class="publication-link-label">arXiv</span></a>{% endcapture %}
        {% assign link_items = link_items | append: link_item | append: '|||' %}
      {% endif %}

      {% if entry.pdf %}
        {% if entry.pdf contains '://' %}
          {% capture link_item %}<a href="{{ entry.pdf }}" class="btn btn-academic-blue btn-sm rounded-pill" target="_blank" rel="noopener noreferrer" role="button" style="text-transform: none;"><i class="fas fa-file-pdf mr-1"></i><span class="publication-link-label">pdf</span></a>{% endcapture %}
        {% else %}
          {% capture link_item %}<a href="{{ entry.pdf | prepend: '/research/' | relative_url }}" class="btn btn-academic-blue btn-sm rounded-pill" target="_blank" rel="noopener noreferrer" role="button" style="text-transform: none;"><i class="fas fa-file-pdf mr-1"></i><span class="publication-link-label">pdf</span></a>{% endcapture %}
        {% endif %}
        {% assign link_items = link_items | append: link_item | append: '|||' %}
      {% endif %}

      {% if entry.code %}
        {% capture link_item %}<a href="{{ entry.code }}" class="btn btn-academic-blue btn-sm rounded-pill" target="_blank" rel="noopener noreferrer" role="button" style="text-transform: none;"><i class="fas fa-code mr-1"></i><span class="publication-link-label">code</span></a>{% endcapture %}
        {% assign link_items = link_items | append: link_item | append: '|||' %}
      {% endif %}

      {% if entry.supp %}
        {% if entry.supp contains '://' %}
          {% capture link_item %}<a href="{{ entry.supp }}" class="btn btn-academic-blue btn-sm rounded-pill" target="_blank" rel="noopener noreferrer" role="button" style="text-transform: none;"><i class="fas fa-paperclip mr-1"></i><span class="publication-link-label">supp</span></a>{% endcapture %}
        {% else %}
          {% capture link_item %}<a href="{{ entry.supp | prepend: '/research/' | relative_url }}" class="btn btn-academic-blue btn-sm rounded-pill" target="_blank" rel="noopener noreferrer" role="button" style="text-transform: none;"><i class="fas fa-paperclip mr-1"></i><span class="publication-link-label">supp</span></a>{% endcapture %}
        {% endif %}
        {% assign link_items = link_items | append: link_item | append: '|||' %}
      {% endif %}

      {% if entry.slides %}
        {% if entry.slides contains '://' %}
          {% capture link_item %}<a href="{{ entry.slides }}" class="btn btn-academic-blue btn-sm rounded-pill" target="_blank" rel="noopener noreferrer" role="button" style="text-transform: none;"><i class="fas fa-file-powerpoint mr-1"></i><span class="publication-link-label">slides</span></a>{% endcapture %}
        {% else %}
          {% capture link_item %}<a href="{{ entry.slides | prepend: '/research/' | relative_url }}" class="btn btn-academic-blue btn-sm rounded-pill" target="_blank" rel="noopener noreferrer" role="button" style="text-transform: none;"><i class="fas fa-file-powerpoint mr-1"></i><span class="publication-link-label">slides</span></a>{% endcapture %}
        {% endif %}
        {% assign link_items = link_items | append: link_item | append: '|||' %}
      {% endif %}

      {% if entry.bibtex_show %}
        {% capture link_item %}<a class="bibtex btn btn-academic-blue btn-sm rounded-pill" role="button" style="text-transform: none;"><span class="publication-link-label">bib</span></a>{% endcapture %}
        {% assign link_items = link_items | append: link_item | append: '|||' %}
      {% endif %}

      {% if entry.html %}
        {% if entry.html contains '://' %}
          {% capture link_item %}<a href="{{ entry.html }}" class="btn btn-academic-blue btn-sm rounded-pill" target="_blank" rel="noopener noreferrer" role="button" style="text-transform: none;"><span class="publication-link-label">html</span></a>{% endcapture %}
        {% else %}
          {% capture link_item %}<a href="{{ entry.html | prepend: '/assets/html/' | relative_url }}" class="btn btn-academic-blue btn-sm rounded-pill" target="_blank" rel="noopener noreferrer" role="button" style="text-transform: none;"><span class="publication-link-label">html</span></a>{% endcapture %}
        {% endif %}
        {% assign link_items = link_items | append: link_item | append: '|||' %}
      {% endif %}

      {% if entry.video and site.enable_video_embedding %}
        {% capture link_item %}<a class="abstract btn btn-academic-blue btn-sm rounded-pill" role="button" style="text-transform: none;"><span class="publication-link-label">video</span></a>{% endcapture %}
        {% assign link_items = link_items | append: link_item | append: '|||' %}
      {% elsif entry.video %}
        {% capture link_item %}<a href="{{ entry.video }}" class="btn btn-academic-blue btn-sm rounded-pill" target="_blank" rel="noopener noreferrer" role="button" style="text-transform: none;"><span class="publication-link-label">video</span></a>{% endcapture %}
        {% assign link_items = link_items | append: link_item | append: '|||' %}
      {% endif %}

      {% if entry.blog %}
        {% capture link_item %}<a href="{{ entry.blog }}" class="btn btn-academic-blue btn-sm rounded-pill" target="_blank" rel="noopener noreferrer" role="button" style="text-transform: none;"><span class="publication-link-label">blog</span></a>{% endcapture %}
        {% assign link_items = link_items | append: link_item | append: '|||' %}
      {% endif %}

      {% if entry.poster %}
        {% if entry.poster contains '://' %}
          {% capture link_item %}<a href="{{ entry.poster }}" class="btn btn-academic-blue btn-sm rounded-pill" target="_blank" rel="noopener noreferrer" role="button" style="text-transform: none;"><span class="publication-link-label">poster</span></a>{% endcapture %}
        {% else %}
          {% capture link_item %}<a href="{{ entry.poster | prepend: '/research/' | relative_url }}" class="btn btn-academic-blue btn-sm rounded-pill" target="_blank" rel="noopener noreferrer" role="button" style="text-transform: none;"><span class="publication-link-label">poster</span></a>{% endcapture %}
        {% endif %}
        {% assign link_items = link_items | append: link_item | append: '|||' %}
      {% endif %}

      {% if entry.website %}
        {% capture link_item %}<a href="{{ entry.website }}" class="btn btn-academic-blue btn-sm rounded-pill" target="_blank" rel="noopener noreferrer" role="button" style="text-transform: none;"><span class="publication-link-label">website</span></a>{% endcapture %}
        {% assign link_items = link_items | append: link_item | append: '|||' %}
      {% endif %}

      {% assign link_list = link_items | split: '|||' %}
      {% for link_item in link_list %}
        {% unless link_item == '' %}
          {{ link_item }}
        {% endunless %}
      {% endfor %}
    </div>
    {% if site.enable_publication_badges %}
      {% assign entry_has_altmetric_badge = false %}
      {% if entry.altmetric and entry.altmetric != 'false' %}
        {% assign entry_has_altmetric_badge = true %}
      {% endif %}

      {% assign entry_has_dimensions_badge = false %}
      {% if entry.dimensions and entry.dimensions != 'false' %}
        {% assign entry_has_dimensions_badge = true %}
      {% endif %}

      {% assign entry_has_google_scholar_badge = false %}
      {% if entry.google_scholar_id %}
        {% assign entry_has_google_scholar_badge = true %}
      {% endif %}

      {% assign entry_has_inspirehep_badge = false %}
      {% if entry.inspirehep_id %}
        {% assign entry_has_inspirehep_badge = true %}
      {% endif %}
      {% if entry_has_altmetric_badge or entry_has_dimensions_badge or entry_has_google_scholar_badge or entry_has_inspirehep_badge %}
        <div class="badges">
          {% if site.enable_publication_badges.altmetric and entry_has_altmetric_badge %}
            <span
              class="altmetric-embed"
              data-badge-type="2"
              data-badge-popover="right"
              {% if entry.altmetric != blank and entry.altmetric != 'true' %}
                data-altmetric-id="{{ entry.altmetric }}"
              {% elsif entry.arxiv %}
                data-arxiv-id="{{ entry.arxiv }}"
              {% elsif entry.eprint %}
                data-arxiv-id="{{ entry.eprint }}"
              {% elsif entry.doi %}
                data-doi="{{ entry.doi }}"
              {% elsif entry.pmid %}
                data-pmid="{{ entry.pmid }}"
              {% elsif entry.isbn %}
                data-isbn="{{ entry.isbn }}"
              {% endif %}
            ></span>
          {% endif %}
          {% if site.enable_publication_badges.dimensions and entry_has_dimensions_badge %}
            <span
              class="__dimensions_badge_embed__"
              {% if entry.dimensions != blank and entry.dimensions != 'true' %}
                data-id="{{ entry.dimensions }}"
              {% elsif entry.doi %}
                data-doi="{{ entry.doi }}"
              {% else %}
                data-pmid="{{ entry.pmid }}"
              {% endif %}
              data-style="small_rectangle"
              data-legend="hover-right"
              style="margin-bottom: 3px;"
            ></span>
          {% endif %}
          {% if site.enable_publication_badges.google_scholar and entry_has_google_scholar_badge %}
            <a
              href="https://scholar.google.com/citations?view_op=view_citation&hl=en&user={{ site.data.socials.scholar_userid }}&citation_for_view={{ site.data.socials.scholar_userid }}:{{ entry.google_scholar_id }}"
              aria-label="Google Scholar link"
              role="button"
            >
              {% assign citation_count = 0 %}
              {% assign scholar_id_key = site.scholar_userid | append: ':' | append: entry.google_scholar_id %}
              {% assign publication_key = entry.google_scholar_id %}

              {% if site.data.citations.papers[scholar_id_key] %}
                {% assign citation_count = site.data.citations.papers[scholar_id_key].citations %}
              {% elsif site.data.citations.papers[publication_key] %}
                {% assign citation_count = site.data.citations.papers[publication_key].citations %}
              {% else %}
                {% for paper in site.data.citations.papers %}
                  {% assign paper_key = paper[0] %}
                  {% if paper_key contains entry.google_scholar_id %}
                    {% assign citation_count = paper[1].citations %}
                    {% break %}
                  {% endif %}
                {% endfor %}
              {% endif %}

              <img
                src="https://img.shields.io/badge/scholar-{{ citation_count }}-4285F4?logo=googlescholar&labelColor=beige"
                alt="{{ citation_count }} Google Scholar citations"
              >
            </a>
          {% endif %}
          {% if site.enable_publication_badges.inspirehep and entry_has_inspirehep_badge %}
            <a
              href="https://inspirehep.net/literature/{{ entry.inspirehep_id }}"
              aria-label="Inspirehep link"
              role="button"
            >
              <img
                src="https://img.shields.io/badge/inspire-{% inspirehep_citations entry.inspirehep_id %}-001628?logo=inspire&logoColor=001628&labelColor=beige"
                alt="{% inspirehep_citations entry.inspirehep_id %} InspireHEP citations"
              >
            </a>
          {% endif %}
        </div>
      {% endif %}
    {% endif %}

    {% if entry.award %}
      <!-- Hidden Award block -->
      <div class="award hidden d-print-inline">
        <p>{{ entry.award | markdownify }}</p>
      </div>
    {% endif %}

    {% if entry.abstract %}
      <!-- Hidden abstract block -->
      <div class="abstract hidden">
        <p>{{ entry.abstract }}</p>
      </div>
    {% endif %}

    {% if entry.bibtex_show %}
      <!-- Hidden bibtex block -->
      <div class="bibtex hidden">
        {% highlight bibtex %}
        {{- entry.bibtex | hideCustomBibtex -}}
        {% endhighlight %}
      </div>
    {% endif %}

    {% if entry.video and site.enable_video_embedding %}
      <!-- Hidden video block -->
      <div class="abstract hidden">
        <div style="text-align: center;">{% include video.liquid path=entry.video class="img-fluid rounded z-depth-1" controls=true %}</div>
      </div>
    {% endif %}
  </div>
</div>
