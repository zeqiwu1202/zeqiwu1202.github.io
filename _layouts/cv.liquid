---
layout: default
---

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
      <a href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}" target="_blank" rel="noopener noreferrer"
        class="float-right">
        <i class="fa-solid fa-file-pdf"></i>
      </a>
      {% endif %}
    </h1>
    {% if page.description %}
    <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="cv">

      {% if site.data.cv.basics %}
      <div class="cv-section mb-5">
        <table class="table table-borderless table-sm">
          <tr>
            <td class="p-0 pr-3 font-weight-bold text-muted" style="width: 15%">Name</td>
            <td class="p-0">{{ site.data.cv.basics.name }}</td>
          </tr>
          <tr>
            <td class="p-0 pr-3 font-weight-bold text-muted">Email</td>
            <td class="p-0"><a href="mailto:{{ site.data.cv.basics.email }}">{{ site.data.cv.basics.email }}</a></td>
          </tr>
          {% if site.data.cv.basics.url %}
          <tr>
            <td class="p-0 pr-3 font-weight-bold text-muted">Website</td>
            <td class="p-0"><a href="{{ site.data.cv.basics.url }}" target="_blank">{{ site.data.cv.basics.url }}</a>
            </td>
          </tr>
          {% endif %}
        </table>
      </div>
      {% endif %}

      {% if site.data.cv.education %}
      <div class="cv-section mb-5">
        <h3 class="mb-4 font-weight-bold">Education</h3>

        {% for edu in site.data.cv.education %}
        <div class="row mb-3">
          <div class="col-md-2 col-sm-3 text-md-left text-muted font-weight-light"
            style="font-size: 0.9rem; min-width: 100px;">
            {% if edu.endDate == "Present" or edu.endDate == "present" %}
            {{ edu.startDate | date: "%Y" }} – Present
            {% else %}
            {{ edu.startDate | date: "%Y" }} – {{ edu.endDate | date: "%Y" }}
            {% endif %}
          </div>

          <div class="col-md-10 col-sm-9">
            <div class="font-weight-bold">
              {{ edu.institution }}
            </div>
            <div class="font-italic">
              {{ edu.studyType }} in {{ edu.area }}
            </div>
            <div class="text-muted small">
              {{ edu.location }}
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {% if site.data.cv.languages %}
      <div class="cv-section mb-5">
        <h3 class="mb-4 font-weight-bold">Languages</h3>
        <ul class="list-unstyled">
          {% for lang in site.data.cv.languages %}
          <li class="mb-1">
            <span class="font-weight-bold">{{ lang.language }}:</span>
            <span class="font-weight-light">{{ lang.fluency }}</span>
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}

    </div>
  </article>
</div>